{
  "name": "ecorean-os",
  "version": "2.0.0",
  "description": "ECOREAN Build Operation Center — 마이크로 프론트엔드",
  "private": true,
  "workspaces": [
    "shell",
    "modules/*",
    "shared"
  ],
  "scripts": {
    "start": "electron .",
    "start:legacy": "electron .",
    "dev": "concurrently -n shell,est,cad -c cyan,yellow,green \"npm run dev --workspace=shell\" \"npm run dev --workspace=modules/estimate\" \"npm run dev --workspace=modules/cad\"",
    "dev:shell": "npm run dev --workspace=shell",
    "build:all": "npm run build --workspaces --if-present",
    "electron": "npm run electron:dev --workspace=shell",
    "build": "electron-builder --win --x64",
    "test": "echo \"No tests\" && exit 0"
  },
  "build": {
    "appId": "com.ecorean.boc",
    "productName": "ECOREAN BOC",
    "copyright": "Copyright © 2026 ECOREAN",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "ECOREAN_BOC_v1.html",
      "src/**/*",
      "js/**/*",
      "style.css",
      "*.json",
      "!node_modules/**/*",
      "!dist/**/*",
      "!ecorean-estimate-os*",
      "!생성파일저장/**/*",
      "!docs/**/*",
      "!docscd/**/*",
      "!**/*.zip",
      "!**/*.bat",
      "!**/*.xlsx"
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ],
      "forceCodeSigning": false,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ECOREAN BOC"
    },
    "portable": {
      "artifactName": "ECOREAN-BOC-${version}-portable.exe"
    }
  },
  "keywords": ["ecorean", "boc", "estimate", "construction"],
  "author": "ECOREAN",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/udunext7-wq/ecorean-os.git"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  }
}
