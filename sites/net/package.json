{
  "name": "@ecorean/site-net",
  "version": "0.1.0",
  "private": true,
  "description": "ecorean.net 호스트 — 내부 운영 (BOC + MiniCAD + System + Partner). 로컬은 루트 node_modules 를 사용, Vercel 배포 시 이 package.json 으로 설치",
  "scripts": {
    "dev": "node ../../scripts/run-next.mjs dev -p 3100",
    "build": "node ../../scripts/run-next.mjs build",
    "start": "node ../../scripts/run-next.mjs start -p 3100",
    "postinstall": "cd ../.. && npm install --no-audit --no-fund"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "next": "^14.2.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4"
  }
}
