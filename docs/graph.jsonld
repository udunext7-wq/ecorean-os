{
  "@context": {
    "@vocab": "https://ecorean.io/ontology/v1#",
    "ecorean": "https://ecorean.io/ontology/v1#",
    "schema": "https://schema.org/"
  },
  "@type": "BusinessGraph",
  "@id": "urn:ecorean:universe:1",
  "version": "5.6",
  "tenantId": "HQ",
  "universe": {
    "id": "ecorean",
    "uri": "urn:business:ecorean",
    "name": "ECOREAN BOC",
    "operator": "udunext7-wq",
    "trust": {
      "outgoing": [
        {
          "@id": "urn:business:vine-farm",
          "name": "포도농장 OS",
          "expectedConnectionDate": "2026-Q4",
          "metaedges": [
            "FAMILY_TRUST",
            "VEHICLE_SHARE",
            "CAPITAL_FLOW",
            "LABOR_POOL",
            "DATA_CROSS",
            "LOGISTICS_HUB"
          ]
        }
      ]
    }
  },
  "nodes": [
    {
      "@type": "Node",
      "@id": "urn:ecorean:universe:1:node:g1_type",
      "id": "g1_type",
      "uri": "urn:ecorean:universe:1:node:g1_type",
      "type": "gate",
      "package": "@ecorean/gate-type",
      "sla": {
        "maxLatencyMs": 100
      }
    },
    {
      "@type": "Node",
      "@id": "urn:ecorean:universe:1:node:g2_concept",
      "id": "g2_concept",
      "uri": "urn:ecorean:universe:1:node:g2_concept",
      "type": "gate",
      "package": "@ecorean/gate-concept",
      "sla": {
        "maxLatencyMs": 200
      },
      "dependsOn": [
        "g1_type"
      ]
    },
    {
      "@type": "Node",
      "@id": "urn:ecorean:universe:1:node:g3_section",
      "id": "g3_section",
      "uri": "urn:ecorean:universe:1:node:g3_section",
      "type": "gate",
      "package": "@ecorean/gate-section",
      "sla": {
        "maxLatencyMs": 200
      },
      "dependsOn": [
        "g2_concept"
      ]
    },
    {
      "@type": "Node",
      "@id": "urn:ecorean:universe:1:node:g4_cad",
      "id": "g4_cad",
      "uri": "urn:ecorean:universe:1:node:g4_cad",
      "type": "gate",
      "package": "@ecorean/gate-cad",
      "sla": {
        "maxLatencyMs": 500
      },
      "dependsOn": [
        "g3_section"
      ]
    },
    {
      "@type": "Node",
      "@id": "urn:ecorean:universe:1:node:g5_material",
      "id": "g5_material",
      "uri": "urn:ecorean:universe:1:node:g5_material",
      "type": "gate",
      "package": "@ecorean/gate-material",
      "sla": {
        "maxLatencyMs": 300
      },
      "dependsOn": [
        "g4_cad"
      ]
    },
    {
      "@type": "Node",
      "@id": "urn:ecorean:universe:1:node:estimate",
      "id": "estimate",
      "uri": "urn:ecorean:universe:1:node:estimate",
      "type": "module",
      "package": "@ecorean/estimate",
      "sla": {
        "maxLatencyMs": 500
      }
    },
    {
      "@type": "Node",
      "@id": "urn:ecorean:universe:1:node:cad",
      "id": "cad",
      "uri": "urn:ecorean:universe:1:node:cad",
      "type": "module",
      "package": "@ecorean/cad",
      "sla": {
        "maxLatencyMs": 300
      },
      "layers": {
        "L1": "ACTIVE",
        "L2": "PLANNED",
        "L3": "PLANNED",
        "L4": "FUTURE",
        "L5": "FUTURE",
        "L6": "FUTURE",
        "L7": "FUTURE"
      }
    },
    {
      "@type": "Node",
      "@id": "urn:ecorean:universe:1:node:kpi",
      "id": "kpi",
      "uri": "urn:ecorean:universe:1:node:kpi",
      "type": "module",
      "package": "@ecorean/kpi",
      "sla": {
        "maxLatencyMs": 100
      }
    },
    {
      "@type": "Node",
      "@id": "urn:ecorean:universe:1:node:calc_engine",
      "id": "calc_engine",
      "uri": "urn:ecorean:universe:1:node:calc_engine",
      "type": "engine",
      "package": "@ecorean/calc-engine",
      "sla": {
        "maxLatencyMs": 200
      }
    },
    {
      "@type": "Node",
      "@id": "urn:ecorean:universe:1:node:ontology_engine",
      "id": "ontology_engine",
      "uri": "urn:ecorean:universe:1:node:ontology_engine",
      "type": "engine",
      "package": "@ecorean/ontology",
      "sla": {
        "maxLatencyMs": 200
      }
    },
    {
      "@type": "Node",
      "@id": "urn:ecorean:universe:1:node:approval_engine",
      "id": "approval_engine",
      "uri": "urn:ecorean:universe:1:node:approval_engine",
      "type": "engine",
      "package": "@ecorean/approval",
      "sla": {
        "maxLatencyMs": 100
      },
      "humanApprover": "operator:udunext7-wq"
    },
    {
      "@type": "Node",
      "@id": "urn:ecorean:universe:1:node:ai_executive",
      "id": "ai_executive",
      "uri": "urn:ecorean:universe:1:node:ai_executive",
      "type": "ml",
      "package": "@ecorean/ai-executive",
      "sla": {
        "maxLatencyMs": 2000
      },
      "autonomyScope": [
        "기존자재단가변경",
        "공정자동매핑",
        "온톨로지룰적용",
        "ML분기"
      ],
      "escalationScope": [
        "새자재등록",
        "새컨셉추가",
        "새사업노드추가",
        "메타엣지신설",
        "다른우주연결",
        "예산1000만원초과"
      ]
    }
  ],
  "edges": [
    {
      "@type": "Edge",
      "id": "e_g1_g2",
      "source": "g1_type",
      "target": "g2_concept",
      "event": "GATE1_LOCKED",
      "scope": "INTRA"
    },
    {
      "@type": "Edge",
      "id": "e_g2_g3",
      "source": "g2_concept",
      "target": "g3_section",
      "event": "GATE2_LOCKED",
