{
  "version": "1.0.0",
  "description": "ECOREAN BOC Neo4j Node Schema — 전환 준비용",
  "nodes": [
    { "type": "Project", "stableIdPrefix": "PROJ",
      "properties": ["name","status","createdAt","region","grade","buildType","buildAge","floorLevel"],
      "sqliteSource": "projects",
      "indexes": ["status","createdAt"] },
    { "type": "Space", "stableIdPrefix": "SPC",
      "properties": ["name","type","width","length","height","area","wet","roof","floor2"],
      "sqliteSource": "spaces",
      "indexes": ["type"] },
    { "type": "Process", "stableIdPrefix": "PROC",
      "properties": ["itemId","itemName","category","unit","laborCost","materialCost","wasteRatio","formula"],
      "sqliteSource": "costItems",
      "indexes": ["itemId","category"] },
    { "type": "OntologyRule", "stableIdPrefix": "ONT",
      "properties": ["ruleId","trigger","linked","triggerType","confidenceLevel","status","condition","note","approvedBy"],
      "sqliteSource": "ontologyRules",
      "indexes": ["trigger","status"] },
    { "type": "Material", "stableIdPrefix": "MAT",
      "properties": ["matId","name","unit","unitPrice","processId","spec","origin"],
      "sqliteSource": "materialItems",
      "indexes": ["matId","processId"] },
    { "type": "Brand", "stableIdPrefix": "BRD",
      "properties": ["brandId","brand","product","grade","supplyPrice","crawledAt","source"],
      "sqliteSource": "brandPriceDb",
      "indexes": ["brand","grade"] },
    { "type": "LaborCrew", "stableIdPrefix": "LAB",
      "properties": ["roleId","roleName","dailyWage","unit","region","year"],
      "sqliteSource": "laborRoles",
      "indexes": ["roleId"] },
    { "type": "Defect", "stableIdPrefix": "DEF",
      "properties": ["defectId","category","name","severity","warrantyYears","description"],
      "sqliteSource": "defectTypes",
      "indexes": ["category","severity"] },
    { "type": "ApprovalLog", "stableIdPrefix": "APL",
      "properties": ["approvalId","actionType","beforeValue","afterValue","approvedBy","approvedAt","reason","requestId"],
      "sqliteSource": "approvalLog",
      "indexes": ["approvalId","actionType"] },
    { "type": "Case", "stableIdPrefix": "CASE",
      "properties": ["projectId","actualCost","estimatedCost","variance","variancePct","lessons","completedAt"],
      "sqliteSource": "completionReports",
      "indexes": ["projectId","completedAt"] },
    { "type": "LearningSuggestion", "stableIdPrefix": "LEARN",
      "properties": ["suggestionId","targetField","targetId","currentValue","proposedValue","confidence","status"],
      "sqliteSource": "mlTrainingData",
      "indexes": ["status","confidence"] },
    { "type": "MLModel", "stableIdPrefix": "ML",
      "properties": ["modelId","type","accuracy","trainedAt","dataCount","version","hyperparams"],
      "sqliteSource": "mlModels",
      "indexes": ["type","trainedAt"] },
    { "type": "CrawlerResult", "stableIdPrefix": "CRAWL",
      "properties": ["crawlId","source","dataType","crawledAt","status","rawData","processedData"],
      "sqliteSource": "crawlerResults",
      "indexes": ["status","dataType"] },
    { "type": "Franchise", "stableIdPrefix": "FRN",
      "properties": ["franchiseId","name","region","modules","tier","openedAt","ownerId"],
      "sqliteSource": "franchises",
      "indexes": ["region","tier"] },
    { "type": "Risk", "stableIdPrefix": "RISK",
      "properties": ["riskId","category","severity","probability","mitigation","status"],
      "sqliteSource": "risks",
      "indexes": ["severity","category"] },
    { "type": "Vendor", "stableIdPrefix": "VND",
      "properties": ["vendorId","name","category","region","rating","contact"],
      "sqliteSource": "subcontractors",
      "indexes": ["category","region"] },
    { "type": "PurchaseOrder", "stableIdPrefix": "PO",
      "properties": ["orderId","itemId","quantity","leadDays","status","orderedAt","deliveredAt"],
      "sqliteSource": null,
      "indexes": ["status","orderedAt"] },
    { "type": "Inspection", "stableIdPrefix": "INSP",
      "properties": ["inspectionId","processId","result","inspectedAt","inspector","notes"],
      "sqliteSource": null,
      "indexes": ["result","inspectedAt"] },
    { "type": "PaymentMilestone", "stableIdPrefix": "PAY",
      "properties": ["milestoneId","rate","amount","dueDate","status","paidAt"],
      "sqliteSource": null,
      "indexes": ["status","dueDate"] },
    { "type": "MasterDbItem", "stableIdPrefix": "MDB",
      "properties": ["itemId","version","approvedBy","effectiveFrom","category","value"],
      "sqliteSource": "masterDbItems",
      "indexes": ["itemId","version","effectiveFrom"] }
  ]
}
