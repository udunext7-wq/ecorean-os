{
  "builds": [
    {
      "src": "sites/net/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    { "src": "/", "dest": "/sites/net/intro.html" },
    { "src": "/home/?", "dest": "/sites/net/home.html" },
    { "src": "/materials", "status": 308, "headers": { "Location": "/materials/" } },
    { "src": "/materials/?", "dest": "/sites/net/materials/index.html" },
    {
      "src": "/(minicad|estimate|estform|pms|work|daily|vector|editor|biz)",
      "status": 308,
      "headers": { "Location": "/$1/" }
    },
    {
      "src": "/(minicad|estimate|estform)(/.*)?",
      "missing": [
        { "type": "cookie", "key": "sb-gdcfqbdgubgpzusbtftf-auth-token" },
        { "type": "cookie", "key": "sb-gdcfqbdgubgpzusbtftf-auth-token.0" }
      ],
      "status": 307,
      "headers": { "Location": "/system.html?next=/$1/" }
    },
    {
      "src": "/(pms|work|daily|vector|editor|biz)(/.*)?",
      "missing": [
        { "type": "cookie", "key": "sb-gdcfqbdgubgpzusbtftf-auth-token" },
        { "type": "cookie", "key": "sb-gdcfqbdgubgpzusbtftf-auth-token.0" }
      ],
      "status": 307,
      "headers": { "Location": "/login?next=/$1/" }
    },
    { "src": "/daily/dashboard/?", "dest": "/sites/net/daily/dashboard/index.html" },
    { "src": "/(minicad|estimate|estform|pms|work|daily|vector|editor|biz)/", "dest": "/sites/net/$1/index.html" },
    { "src": "/(.*)", "dest": "/sites/net/$1" }
  ]
}
