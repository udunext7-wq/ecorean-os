{
  "name": "@ecorean/shell",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development electron electron/main.js",
    "electron:build": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@ecorean/shared": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "cross-env": "^7.0.3",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "com.ecorean.boc",
    "productName": "ECOREAN BOC",
    "directories": { "output": "../dist-electron" },
    "files": ["dist/**/*", "electron/**/*", "public/**/*"],
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "forceCodeSigning": false
    }
  }
}
